 {
  "name": "metavar-regex-secret",
  "rule": {
   "patterns": [
    {
     "pattern": "private const string $N = $V;"
    },
    {
     "metavariable-regex": {
      "metavariable": "$V",
      "regex": "^\"[0-9a-f]{32,}\"$"
     }
    }
   ]
  },
  "expect": [
   9
  ]
 },
 {
  "name": "metavar-pattern-generic",
  "rule": {
   "patterns": [
    {
     "pattern": "new SqlCommand($Q)"
    },
    {
     "metavariable-pattern": {
      "metavariable": "$Q",
      "language": "generic",
      "pattern": "SELECT"
     }
    }
   ]
  },
  "expect": [
   17
  ]
 },
 {
  "name": "metavar-comparison",
  "rule": {
