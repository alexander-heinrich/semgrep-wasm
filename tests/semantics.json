 {
  "name": "taint-basic",
  "rule": {
   "mode": "taint",
   "pattern-sources": [
    {
     "patterns": [
      {
       "pattern-inside": "public static void Run(string $P, ...) { ... }"
      },
      {
       "focus-metavariable": "$P"
      }
     ]
    }
   ],
   "pattern-sinks": [
    {
     "pattern": "Process.Start(...)"
    }
   ]
  },
  "expect": [
   18,
   25
  ]
 },
 {
  "name": "taint-sanitizer",
  "rule": {
   "mode": "taint",
   "pattern-sources": [
    {
     "pattern": "$S.ToLower()"
    }
   ],
   "pattern-sanitizers": [
    {
     "pattern": "Clean(...)"
    }
   ],
   "pattern-sinks": [
    {
     "pattern": "Foo(...)"
    }
   ]
  },
  "expect": [
   39
  ]
 },
 {
  "name": "taint-propagator",
  "rule": {
   "mode": "taint",
   "pattern-sources": [
    {
     "pattern": "input"
    }
   ],
   "pattern-propagators": [
    {
     "pattern": "$CMD = new SqlCommand($X)",
     "from": "$X",
     "to": "$CMD"
    }
   ],
   "pattern-sinks": [
    {
     "pattern": "Process.Start(...)"
    }
   ]
  },
  "expect": [
   18,
   25
  ]
 },
 {
  "name": "taint-by-side-effect-key",
  "rule": {
