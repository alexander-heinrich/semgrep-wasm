 {
  "name": "multi-two-files",
  "note": "several targets in one call; reported paths carry no run directory",
  "rule": {
   "pattern": "Foo($X);"
  },
  "targets": [
   {
    "path": "src/A.cs",
    "text": "class A { void M() { Foo(1); } }"
   },
   {
    "path": "src/B.cs",
    "text": "class B { void M() { Foo(2);\nFoo(3); } }"
   }
  ],
  "expect": {
   "src/A.cs": [
    1
   ],
   "src/B.cs": [
    1,
    2
   ]
  }
 },
 {
  "name": "multi-paths-glob",
